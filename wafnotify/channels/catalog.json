[
  {
    "type": "dingtalk",
    "name": "钉钉群机器人",
    "hint": "",
    "fields": [
      {
        "key": "msgtype",
        "label": "消息类型",
        "kind": "select",
        "default": "markdown",
        "options": [
          "text",
          "markdown"
        ]
      },
      {
        "key": "atAll",
        "label": "@所有人",
        "kind": "boolean"
      },
      {
        "key": "atMobiles",
        "label": "@手机号",
        "kind": "text",
        "hint": "多个用英文逗号分隔；企业微信仅文本消息生效"
      },
      {
        "key": "atDingtalkIds",
        "label": "@钉钉用户 ID",
        "kind": "text",
        "hint": "多个用英文逗号分隔"
      }
    ]
  },
  {
    "type": "dingtalk_app",
    "name": "钉钉企业内机器人",
    "hint": "在钉钉开放平台创建企业内部应用并启用机器人，授予机器人发送消息权限。",
    "fields": [
      {
        "key": "agentID",
        "label": "AgentID",
        "kind": "text",
        "hint": "与参考项目保持相同配置；新版单聊接口使用 AppKey 作为 robotCode"
      },
      {
        "key": "appKey",
        "label": "AppKey",
        "kind": "text",
        "required": true
      },
      {
        "key": "appSecret",
        "label": "App Secret",
        "kind": "password",
        "required": true,
        "secret": true
      },
      {
        "key": "userIds",
        "label": "接收用户 ID",
        "kind": "text",
        "required": true,
        "hint": "多个用英文逗号分隔，单次最多 20 人"
      },
      {
        "key": "msgKey",
        "label": "消息类型",
        "kind": "select",
        "default": "sampleText",
        "options": [
          "sampleText",
          "sampleMarkdown"
        ]
      }
    ]
  },
  {
    "type": "wechatwork",
    "name": "企业微信群机器人",
    "hint": "",
    "fields": [
      {
        "key": "msgType",
        "label": "消息类型",
        "kind": "select",
        "default": "markdown",
        "options": [
          "text",
          "markdown"
        ]
      },
      {
        "key": "atAll",
        "label": "@所有人",
        "kind": "boolean"
      },
      {
        "key": "atUserIds",
        "label": "@用户 ID",
        "kind": "text",
        "hint": "多个用英文逗号分隔，仅文本消息生效"
      },
      {
        "key": "atMobiles",
        "label": "@手机号",
        "kind": "text",
        "hint": "多个用英文逗号分隔；企业微信仅文本消息生效"
      }
    ]
  },
  {
    "type": "wechatwork_app",
    "name": "企业微信应用消息",
    "hint": "使用企业微信自建应用；设置应用可见范围及可信 IP。自定义 API 可用于企业微信接口代理。",
    "fields": [
      {
        "key": "corpID",
        "label": "企业 ID",
        "kind": "text",
        "required": true
      },
      {
        "key": "agentID",
        "label": "AgentID",
        "kind": "number",
        "required": true
      },
      {
        "key": "secret",
        "label": "应用 Secret",
        "kind": "password",
        "required": true,
        "secret": true
      },
      {
        "key": "toUser",
        "label": "接收成员",
        "kind": "text",
        "default": "@all",
        "hint": "@all 表示全部；多个成员用 | 分隔"
      },
      {
        "key": "toParty",
        "label": "接收部门",
        "kind": "text",
        "hint": "多个用 | 分隔"
      },
      {
        "key": "toTag",
        "label": "接收标签",
        "kind": "text",
        "hint": "多个用 | 分隔"
      },
      {
        "key": "customizeAPI",
        "label": "自定义 API",
        "kind": "url",
        "default": "https://qyapi.weixin.qq.com",
        "required": true
      }
    ]
  },
  {
    "type": "feishu",
    "name": "飞书群机器人",
    "hint": "",
    "fields": [
      {
        "key": "msgType",
        "label": "消息类型",
        "kind": "select",
        "default": "interactive",
        "options": [
          "text",
          "interactive"
        ]
      },
      {
        "key": "atAll",
        "label": "@所有人",
        "kind": "boolean"
      },
      {
        "key": "atOpenIds",
        "label": "@用户 ID",
        "kind": "text",
        "hint": "多个 open_id / user_id 用英文逗号分隔"
      },
      {
        "key": "messageCard",
        "label": "自定义消息卡片",
        "kind": "textarea",
        "when": {
          "msgType": [
            "interactive"
          ]
        },
        "hint": "可选 JSON；字符串内可用 {{MSG_TITLE}} / {{MSG_CONTENT}}，自动转义。"
      }
    ]
  },
  {
    "type": "feishu_app",
    "name": "飞书企业应用",
    "hint": "创建飞书企业自建应用，启用机器人并授权 im:message:send_as_bot；接收 ID 必须与所选类型一致。",
    "fields": [
      {
        "key": "appId",
        "label": "App ID",
        "kind": "text",
        "required": true
      },
      {
        "key": "appSecret",
        "label": "App Secret",
        "kind": "password",
        "required": true,
        "secret": true
      },
      {
        "key": "receiveIdType",
        "label": "接收 ID 类型",
        "kind": "select",
        "default": "user_id",
        "options": [
          "open_id",
          "user_id",
          "union_id",
          "email",
          "chat_id"
        ]
      },
      {
        "key": "receiveId",
        "label": "接收 ID",
        "kind": "text",
        "required": true
      },
      {
        "key": "msgType",
        "label": "消息类型",
        "kind": "select",
        "default": "interactive",
        "options": [
          "text",
          "interactive"
        ]
      },
      {
        "key": "messageCard",
        "label": "自定义消息卡片",
        "kind": "textarea",
        "when": {
          "msgType": [
            "interactive"
          ]
        },
        "hint": "可选 JSON；字符串内可用 {{MSG_TITLE}} / {{MSG_CONTENT}}，自动转义。"
      }
    ]
  },
  {
    "type": "email",
    "name": "邮箱",
    "hint": "",
    "fields": []
  },
  {
    "type": "bark",
    "name": "Bark",
    "hint": "将 Bark App 的完整推送地址填入即可，HomeWaf 直接向 Bark 服务发送。",
    "fields": [
      {
        "key": "server",
        "label": "推送地址",
        "kind": "url",
        "required": true,
        "secret": true,
        "hint": "完整地址，例如 https://api.day.app/你的设备Key；也支持自建服务器"
      },
      {
        "key": "group",
        "label": "分组名称",
        "kind": "text"
      },
      {
        "key": "icon",
        "label": "消息图标 URL",
        "kind": "text"
      },
      {
        "key": "sound",
        "label": "提示音",
        "kind": "text"
      },
      {
        "key": "badge",
        "label": "角标",
        "kind": "number"
      },
      {
        "key": "url",
        "label": "点击跳转链接",
        "kind": "text"
      },
      {
        "key": "level",
        "label": "通知级别",
        "kind": "select",
        "default": "active",
        "options": [
          "passive",
          "active",
          "timeSensitive",
          "critical"
        ]
      },
      {
        "key": "call",
        "label": "持续提醒",
        "kind": "select",
        "default": "",
        "options": [
          "",
          "1"
        ]
      },
      {
        "key": "autoCopy",
        "label": "复制内容",
        "kind": "text",
        "hint": "可用 [title] / [content]"
      },
      {
        "key": "transformation",
        "label": "推送加密",
        "kind": "select",
        "default": "none",
        "options": [
          "none",
          "AES128/CBC/PKCS7Padding",
          "AES192/CBC/PKCS7Padding",
          "AES256/CBC/PKCS7Padding",
          "AES128/ECB/PKCS7Padding",
          "AES192/ECB/PKCS7Padding",
          "AES256/ECB/PKCS7Padding",
          "AES128/GCM/NoPadding",
          "AES192/GCM/NoPadding",
          "AES256/GCM/NoPadding"
        ]
      },
      {
        "key": "key",
        "label": "加密密钥",
        "kind": "password",
        "secret": true,
        "hint": "与 Bark App 中的密钥一致；AES128/192/256 分别为 16/24/32 字节",
        "when": {
          "transformation": [
            "AES128/CBC/PKCS7Padding",
            "AES192/CBC/PKCS7Padding",
            "AES256/CBC/PKCS7Padding",
            "AES128/ECB/PKCS7Padding",
            "AES192/ECB/PKCS7Padding",
            "AES256/ECB/PKCS7Padding",
            "AES128/GCM/NoPadding",
            "AES192/GCM/NoPadding",
            "AES256/GCM/NoPadding"
          ]
        }
      },
      {
        "key": "iv",
        "label": "初始向量 IV",
        "kind": "password",
        "secret": true,
        "hint": "CBC 为 16 字节，GCM 为 12 字节；留空自动生成",
        "when": {
          "transformation": [
            "AES128/CBC/PKCS7Padding",
            "AES192/CBC/PKCS7Padding",
            "AES256/CBC/PKCS7Padding",
            "AES128/GCM/NoPadding",
            "AES192/GCM/NoPadding",
            "AES256/GCM/NoPadding"
          ]
        }
      }
    ]
  },
  {
    "type": "webhook",
    "name": "自定义 Webhook",
    "hint": "",
    "fields": []
  },
  {
    "type": "telegram",
    "name": "Telegram 机器人",
    "hint": "通过 BotFather 创建机器人。私聊需先启动机器人；群聊需将机器人加入群组。",
    "fields": [
      {
        "key": "apiToken",
        "label": "Bot Token",
        "kind": "password",
        "required": true,
        "secret": true
      },
      {
        "key": "chatId",
        "label": "Chat ID",
        "kind": "text",
        "required": true
      },
      {
        "key": "messageThreadId",
        "label": "话题 ID",
        "kind": "number"
      },
      {
        "key": "method",
        "label": "请求方法",
        "kind": "select",
        "default": "POST",
        "options": [
          "POST",
          "GET"
        ]
      },
      {
        "key": "parseMode",
        "label": "消息格式",
        "kind": "select",
        "default": "TEXT",
        "options": [
          "TEXT",
          "HTML",
          "MarkdownV2"
        ]
      },
      {
        "key": "apiBase",
        "label": "API 地址",
        "kind": "url",
        "default": "https://api.telegram.org",
        "required": true,
        "hint": "可使用自建 Bot API 服务；网络代理使用 HomeWaf 系统代理配置"
      }
    ]
  },
  {
    "type": "serverchan",
    "name": "Server酱",
    "hint": "",
    "fields": [
      {
        "key": "channel",
        "label": "推送通道",
        "kind": "text",
        "hint": "可选，多个通道 ID 用 | 分隔，例如 9|66"
      },
      {
        "key": "openid",
        "label": "抄送 OpenID",
        "kind": "text",
        "hint": "可选，参考 Server酱账户配置"
      }
    ]
  },
  {
    "type": "pushplus",
    "name": "PushPlus",
    "hint": "使用 PushPlus 账户 Token；群组、渠道与 Webhook 编码按 PushPlus 后台配置。",
    "fields": [
      {
        "key": "website",
        "label": "服务网站",
        "kind": "select",
        "default": "www.pushplus.plus",
        "options": [
          "www.pushplus.plus",
          "www.pushplus.hxtrip.com"
        ]
      },
      {
        "key": "token",
        "label": "Token",
        "kind": "password",
        "required": true,
        "secret": true
      },
      {
        "key": "topic",
        "label": "群组编码",
        "kind": "text"
      },
      {
        "key": "template",
        "label": "消息模板",
        "kind": "select",
        "default": "markdown",
        "options": [
          "html",
          "txt",
          "json",
          "markdown"
        ]
      },
      {
        "key": "channel",
        "label": "推送通道",
        "kind": "select",
        "default": "wechat",
        "options": [
          "wechat",
          "webhook",
          "cp",
          "mail",
          "sms"
        ]
      },
      {
        "key": "webhook",
        "label": "Webhook 编码",
        "kind": "text"
      },
      {
        "key": "callbackUrl",
        "label": "回调地址",
        "kind": "text"
      },
      {
        "key": "validTime",
        "label": "有效期（秒）",
        "kind": "number",
        "default": 0
      }
    ]
  },
  {
    "type": "gotify",
    "name": "Gotify",
    "hint": "在 Gotify 创建 Application，复制消息接口地址及应用 Token。",
    "fields": [
      {
        "key": "webServer",
        "label": "推送地址",
        "kind": "url",
        "required": true,
        "secret": true,
        "hint": "完整地址，例如 https://gotify.example.com/message?token=应用Token"
      },
      {
        "key": "priority",
        "label": "优先级",
        "kind": "number",
        "default": 5
      }
    ]
  },
  {
    "type": "socket",
    "name": "Socket（MQTT / TCP / UDP）",
    "hint": "直接连接消息服务器。内网目标须在 config.yml 的 security.outbound_allowed_hosts 中配置。",
    "fields": [
      {
        "key": "method",
        "label": "协议",
        "kind": "select",
        "default": "MQTT",
        "options": [
          "MQTT",
          "TCP",
          "UDP"
        ]
      },
      {
        "key": "address",
        "label": "主机地址",
        "kind": "text",
        "required": true,
        "hint": "只填域名或 IP，不含协议、端口或路径"
      },
      {
        "key": "port",
        "label": "端口",
        "kind": "number",
        "default": 1883,
        "required": true
      },
      {
        "key": "msgTemplate",
        "label": "消息模板",
        "kind": "textarea",
        "default": "{\"title\":\"[title]\",\"msg\":\"[msg]\"}",
        "hint": "支持 [title] [content] [msg] [timestamp] [sign]；JSON 模板自动转义，其他模板按 URL 编码"
      },
      {
        "key": "secret",
        "label": "签名密钥",
        "kind": "password",
        "secret": true
      },
      {
        "key": "response",
        "label": "成功应答关键字",
        "kind": "text",
        "hint": "留空表示发送完成即成功；填写后会等待应答并验证"
      },
      {
        "key": "inCharset",
        "label": "接收编码",
        "kind": "select",
        "default": "UTF-8",
        "options": [
          "UTF-8",
          "GBK",
          "GB18030",
          "ISO-8859-1"
        ]
      },
      {
        "key": "outCharset",
        "label": "发送编码",
        "kind": "select",
        "default": "UTF-8",
        "options": [
          "UTF-8",
          "GBK",
          "GB18030",
          "ISO-8859-1"
        ]
      },
      {
        "key": "username",
        "label": "用户名",
        "kind": "text",
        "when": {
          "method": [
            "MQTT"
          ]
        }
      },
      {
        "key": "password",
        "label": "密码",
        "kind": "password",
        "secret": true,
        "when": {
          "method": [
            "MQTT"
          ]
        }
      },
      {
        "key": "outMessageTopic",
        "label": "发布主题",
        "kind": "text",
        "required": true,
        "when": {
          "method": [
            "MQTT"
          ]
        }
      },
      {
        "key": "inMessageTopic",
        "label": "接收主题",
        "kind": "text",
        "when": {
          "method": [
            "MQTT"
          ]
        }
      },
      {
        "key": "uriType",
        "label": "传输方式",
        "kind": "select",
        "default": "tcp",
        "options": [
          "tcp",
          "ssl",
          "ws",
          "wss"
        ],
        "when": {
          "method": [
            "MQTT"
          ]
        }
      },
      {
        "key": "path",
        "label": "WebSocket 路径",
        "kind": "text",
        "default": "/mqtt",
        "when": {
          "method": [
            "MQTT"
          ],
          "uriType": [
            "ws",
            "wss"
          ]
        }
      },
      {
        "key": "clientId",
        "label": "Client ID",
        "kind": "text",
        "when": {
          "method": [
            "MQTT"
          ]
        },
        "hint": "留空随机生成"
      },
      {
        "key": "qos",
        "label": "QoS",
        "kind": "select",
        "default": "0",
        "options": [
          "0",
          "1",
          "2"
        ],
        "when": {
          "method": [
            "MQTT"
          ]
        }
      },
      {
        "key": "retained",
        "label": "保留消息",
        "kind": "boolean",
        "when": {
          "method": [
            "MQTT"
          ]
        }
      }
    ]
  }
]
